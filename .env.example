LLM_PROVIDER=gemini

GEMINI_API_KEY=your-key
GOOGLE_GEMINI_BASE_URL=https://api.aicodemirror.com/api/gemini
GEMINI_MODEL=gemini-3-flash-preview

DEEPSEEK_API_KEY=your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

EVAL_JUDGE_PROVIDER=deepseek
EVAL_MAX_WORKERS=1
EVAL_TIMEOUT_SECONDS=120
EVAL_MAX_RETRIES=2

EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_MODEL_PATH=/home/tony/.cache/huggingface/hub/models--BAAI--bge-m3/snapshots/5617a9f61b028005a4858fdac845db406aefb181

PG_HOST=127.0.0.1
PG_PORT=5434
PG_DATABASE=llama_rag
PG_USER=postgres
PG_PASSWORD=postgres
PG_TABLE=rag_documents

UPLOAD_DIR=/home/tony/Code/LLM_App/LlamaindexRAG/data/uploads
TOP_K=5
SYSTEM_PROMPT=You are a helpful RAG assistant. Use the retrieved context when it is relevant, and say when the answer is not grounded in the uploaded documents.

# --- Reranker (cross-encoder, default off) ---
# RERANKER_ENABLED=true
# RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
# RERANKER_MODEL_PATH=/path/to/local/bge-reranker-v2-m3
# RETRIEVAL_TOP_K=20   # candidates fetched before reranking; narrowed to TOP_K

# --- Hybrid search: BM25 + vector with RRF fusion (default off) ---
# Requires /api/index/rebuild after enabling; BM25 index lives in memory.
# HYBRID_SEARCH_ENABLED=true

# --- Query transformation (default none) ---
# QUERY_TRANSFORM_MODE=multi_query   # or: hyde
# NUM_QUERIES=4                      # total queries for multi_query (incl. original)

# --- Chunking strategy (default sentence) ---
# CHUNK_MODE=semantic          # embedding-based boundaries (SemanticSplitterNodeParser)
# CHUNK_MODE=sentence_window   # small chunks + window expansion (SentenceWindowNodeParser)
# CHUNK_MODE=layout_aware      # by file extension: .md -> MarkdownNodeParser,
#                               # .json -> JSONNodeParser, other -> SentenceSplitter.
#                               # Does not apply to PDF/Office files when PDF_PARSER=docling.
# SEMANTIC_BUFFER_SIZE=1
# SEMANTIC_BREAKPOINT_THRESHOLD=95.0
# SENTENCE_WINDOW_SIZE=3

# --- PDF parsing (default default) ---
# PDF_PARSER=pymupdf4llm   # convert PDF to Markdown via pymupdf4llm before indexing
# PDF_PARSER=docling       # convert PDF/DOCX/PPTX/XLSX via docling (layout-aware,
#                           # hierarchical chunking); slower, better on tables/complex
#                           # layout. First run downloads docling's layout model.
#                           # Other file types still fall back to CHUNK_MODE above.
